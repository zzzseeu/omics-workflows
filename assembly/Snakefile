def finishing_delivery(w):
    return config['samples'][w.sample]['settings']['finishing']['source_delivery'] or f'samples/{w.sample}/06_scaffolding/delivery/manifest.json'


def finishing_source_files(w):
    source=config['samples'][w.sample]['settings']['finishing']['source_delivery']
    if source:
        manifest=json.loads(Path(source).read_text())
        return [str(Path(source).parent/(label+'.fa')) for label in manifest['sets']]
    return [p for p in CHROMOSOME_ARTIFACTS if f'samples/{w.sample}/' in p]


def wgs_source_files(w):
    return [r[k] for r in config['samples'][w.sample]['readsets'].values()
            if r['technology']=='wgs' for k in ('file1','file2')]


wildcard_constraints:
    sample='[A-Za-z0-9][A-Za-z0-9_.-]*',
    readset='[A-Za-z0-9][A-Za-z0-9_.-]*'


