def sample_readsets(sample, technology=None):
    return [rid for rid, r in config['samples'][sample]['readsets'].items()
            if (r['technology'] == technology if technology else r['technology'] in ('hifi','ont'))]


def sample_files(sample, pattern):
    return [pattern.format(sample=sample, readset=r) for r in sample_readsets(sample)]



SCRIPTS = ROOT / 'assembly/scripts'


def script_path(name):
    return str(SCRIPTS / (name + '.py'))


def script_helpers(name):
    """Declare imported local helper sources as tracked Snakemake inputs."""
    import ast
    dependencies = set()
    pending = [name]
    while pending:
        helper_name = pending.pop()
        for node in ast.walk(ast.parse(Path(script_path(helper_name)).read_text())):
            if isinstance(node, ast.ImportFrom) and node.module:
                source = Path(script_path(node.module))
                if source.is_file() and str(source) not in dependencies:
                    dependencies.add(str(source))
                    pending.append(node.module)
    return sorted(dependencies)


JOINT_PATTERN = '|'.join(re.escape(s) for s in JOINT_SAMPLES) or '(?!)'


def technology_files(sample, technology):
    return [f'samples/{sample}/01_inputs/{r}.fastq.gz'
            for r in sample_readsets(sample, technology)]


def paired_files(sample):
    return [f'samples/{sample}/01_inputs/{r}.paired.json'
            for r in sample_readsets(sample, 'hic')]


T2T_SAMPLES=[s for s in SAMPLES if config['samples'][s]['settings']['finishing']['enabled']]
T2T_PATTERN='|'.join(re.escape(s) for s in T2T_SAMPLES) or '(?!)'
T2T_ARTIFACTS=expand('samples/{sample}/{name}',sample=T2T_SAMPLES,name=[
