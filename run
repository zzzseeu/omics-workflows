#!/usr/bin/env python3
"""Unified, scheduler-independent entry point for reusable omics workflows."""
import argparse
import sys

sys.dont_write_bytecode = True


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("workflow", choices=["assembly"], help="Workflow to execute")
    if len(sys.argv) == 1:
        parser.print_help()
        return 0
    # Parse only the workflow here; each module owns its complete option parser.
    # Module --help must work without importing scientific dependencies.
    if sys.argv[1] in ("-h", "--help"):
        parser.print_help()
        return 0
    selected = parser.parse_args(sys.argv[1:2])
    if selected.workflow == "assembly":
        from assembly.runner import main as run_assembly

        return run_assembly(sys.argv[2:], prog=f"{parser.prog} assembly")

    return 2


if __name__ == "__main__":
    raise SystemExit(main())
